# Vision360 API — Environment Variables
# Copy this file to .env and fill in your values

PORT=3000

# Cloudinary (required — get these from https://console.cloudinary.com/settings)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Allowed frontend origins (comma-separated)
# Example: https://vision360-ten.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=https://vision360-ten.vercel.app
