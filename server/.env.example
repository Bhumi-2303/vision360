# Vision360 API — Environment Variables
# Copy this file to .env and fill in your values

PORT=3000

# Cloudinary (required)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Allowed frontend origins (comma-separated)
# Example: https://vision360.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=
